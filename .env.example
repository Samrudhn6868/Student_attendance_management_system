# Copy this file to .env and fill values before running the app
# Do NOT commit the actual .env with real secrets

SECRET_KEY=replace-with-a-random-secret
DATABASE_URL=sqlite:///attendance.db
FLASK_ENV=development

# SAS-88: JWT Configuration for Role-Based Access Control
# Generate a strong random key for production:
# python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET_KEY=replace-with-a-strong-random-jwt-secret

# SAS-93: Attendance API Configuration
# JWT token expiration time (in hours)
JWT_EXPIRATION_HOURS=24

# SAS-92: Encryption key for encrypting attendance data at rest
# Generate a Fernet key with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Do NOT commit the real key to source control. Keep it secret.
ENCRYPTION_KEY=replace-with-base64-fernet-key

